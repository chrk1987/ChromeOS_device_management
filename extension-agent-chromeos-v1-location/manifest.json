{
  "manifest_version": 3,
  "name": "Halo Agent",
  "version": "1.5",
  "description": "Reports device data to your organization's management system.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "permissions": [
    "enterprise.deviceAttributes",
    "offscreen",
    "alarms",
    "geolocation",
    "storage"
  ],
  "host_permissions": [
    "https://*.halofort.com/*",
    "https://*.tectoro.com/*",
    "https://nominatim.openstreetmap.org/*"
  ],
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
